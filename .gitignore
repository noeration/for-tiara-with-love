# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# dev-only content store (local fallback)
/data/draft.json
/data/published.json
/public/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build logs
build*.log
server*.log
*.log

# qa / test artifacts
/qa
/.playwright-mcp
screenshot*.js
screenshot*.png

# misc scripts
*.cmd
run-site.cmd
start-dev.cmd
