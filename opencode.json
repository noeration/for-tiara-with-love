{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "shadcn": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "shadcn@latest",
          "mcp"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ]
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      }
    }
  }
}